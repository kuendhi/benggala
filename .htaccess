# ==============================================================================
# Benggala Server Hardening (.htaccess)
# ==============================================================================

# 1. Matikan Directory Listing
Options -Indexes

# 2. Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Blokir Akses ke Folder VCS (.git)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git - [F,L]
</IfModule>

# 4. Blokir Total Akses Publik ke File Sensitif (.env, .env.example, .git, .gitignore, *.json, *.log)
<FilesMatch "(^\.env|\.git|\.gitignore|(\.json|\.log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
